# Optional override for the .env location. Export it before starting the CLI;
# a value inside .env cannot select that same file.
ENV_FILE=

# PostgreSQL connection string.
DATABASE_URL=postgres://seo:seo@localhost:5432/seo?sslmode=disable

# Optional path to the task_1 import workbook.
INPUT_FILE_PATH=input/task_1/input.xlsx

# Optional task_1 artifact directory.
OUTPUT_DIR=tasks/task_1/output

KEYS_SO_EMAIL=
KEYS_SO_PASSWORD=

ARSENKIN_EMAIL=
ARSENKIN_PASSWORD=
ARSENKIN_HEADLESS=true

GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# Supported levels: debug, info, warn, error.
LOG_LEVEL=info
# Формат логов консоли.
#   auto   — по умолчанию: человекочитаемый в терминале, text в пайпе и в файле
#   pretty — человекочитаемый всегда
#   text   — key=value всегда, если вывод разбирают инструментами
#   json   — structured JSON для Loki и ELK
# Логи статей в logs/<операция>.log всегда text или json, независимо от этого значения.
LOG_FORMAT=

# Площадка публикации pprof_1. Переменные с префиксом задачи: сайтов у проекта несколько,
# и адрес одной задачи не должен протекать в другую.
# WORDPRESS_APP_PASSWORD — Application Password из профиля пользователя WordPress,
# а не пароль администратора: он отзывается отдельно и не даёт входа в админку.
# Проверка доступа: make pprof-1 wordpress-check
PPROF_1_WORDPRESS_URL=
PPROF_1_WORDPRESS_USERNAME=
PPROF_1_WORDPRESS_APP_PASSWORD=

# Публиковать ли статью сразу после полного прогона (make pprof-1 run).
# Пусто или false — не публиковать: run запускают ради текста, а публикация необратима,
# и удалять записи в блоге приложение не умеет. true включает публикацию последним этапом
# прогона; отказ площадки при этом генерацию не роняет, а после трёх подряд отказов
# публикация в этом прогоне выключается, и статьи остаются для команды publish.
PPROF_1_WORDPRESS_PUBLISH_AFTER_RUN=
