# Optional override for the .env location. Export it before starting the CLI;
# a value inside .env cannot select that same file.
ENV_FILE=

# PostgreSQL connection string.
DATABASE_URL=postgres://seo:seo@localhost:5432/seo?sslmode=disable

# Optional path to the task_1 import workbook.
INPUT_FILE_PATH=input/task_1/input.xlsx

# Optional task_1 artifact directory.
OUTPUT_DIR=tasks/task_1/output

KEYS_SO_EMAIL=
KEYS_SO_PASSWORD=

ARSENKIN_EMAIL=
ARSENKIN_PASSWORD=
ARSENKIN_HEADLESS=true

GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# Supported levels: debug, info, warn, error.
LOG_LEVEL=info
# Формат логов консоли.
#   auto   — по умолчанию: человекочитаемый в терминале, text в пайпе и в файле
#   pretty — человекочитаемый всегда
#   text   — key=value всегда, если вывод разбирают инструментами
#   json   — structured JSON для Loki и ELK
# Логи статей в logs/<операция>.log всегда text или json, независимо от этого значения.
LOG_FORMAT=
