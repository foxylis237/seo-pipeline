# Optional override for the .env location. Export it before starting the CLI;
# a value inside .env cannot select that same file.
ENV_FILE=

# PostgreSQL connection string.
DATABASE_URL=postgres://seo:seo@localhost:5432/seo?sslmode=disable

# Optional path to the import workbook. Defaults to input/input.xlsx.
INPUT_FILE_PATH=input/input.xlsx

KEYS_SO_EMAIL=
KEYS_SO_PASSWORD=

ARSENKIN_EMAIL=
ARSENKIN_PASSWORD=
ARSENKIN_HEADLESS=true

# Supported levels: debug, info, warn, error.
LOG_LEVEL=info
# Supported formats: text, json.
LOG_FORMAT=text
