# Input
input/**/*.xlsx
!input/task_1/input.xlsx
# Регламенты стадий: рабочие документы задачи, как и книги импорта.
input/**/regulations/**/*.pdf

# Обложки статей: файлы — данные, а не код. Каталог и его README в репозитории остаются,
# чтобы было видно, куда их класть и по какому имени.
input/**/images/*
!input/**/images/.gitkeep
!input/**/images/README.md
tasks/*/input/**/*.xlsx

